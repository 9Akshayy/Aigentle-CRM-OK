{
  "name": "aigentle-crm",
  "version": "1.0.0",
  "description": "Lead Management CRM for Aigentle IT Services",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "crm",
    "leads",
    "it-services",
    "pipeline",
    "aigentle"
  ],
  "author": "Aigentle IT Services",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
